{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Supabase": {
    "Url": "https://your-project-ref.supabase.co",
    "AnonKey": "your-anon-key",
    "ServiceRoleKey": "your-service-role-key"
  },
  "ConnectionStrings": {
    "Supabase": "Host=your-project-ref.pooler.supabase.com;Port=5432;Database=postgres;Username=app_backend;Password=your-password;SSL Mode=Require;Trust Server Certificate=true;Pooling=true;Maximum Pool Size=20"
  },
  "Jwt": {
    "Issuer": "https://your-project-ref.supabase.co/auth/v1",
    "Audience": "authenticated"
  },
  "Email": {
    "Provider": "smtp",
    "From": "no-reply@varsityhub.co.za"
  },
  "Payments": {
    "Provider": "payfast"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
